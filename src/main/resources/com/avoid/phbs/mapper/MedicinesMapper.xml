<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.avoid.phbs.mapper.MedicinesMapper">
    <!--动态sql-->
    <select id="list" resultType="com.avoid.phbs.model.Medicines">
        select * from medicines
        <where>
            <if test="state!=null">
                and state=#{state}
            </if>

            and create_admin=#{adminId}
        </where>
    </select>
</mapper>