<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.avoid.phbs.mapper.AdviceMapper">
    <!--动态sql-->
    <select id="list" resultType="com.avoid.phbs.model.Advice">
        select * from advice
        <where>
            <if test="userId!=null">
                user_id=#{userId}
            </if>
            <if test="state!=null">
                and state=#{state}
            </if>

            and admin_id=#{adminId}
        </where>
    </select>
</mapper>